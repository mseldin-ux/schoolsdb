$mappingurl="js2/cgms_mapping_lib3.php";
if ($_REQUEST['startzoom']) {
	$mappingurl.="?startzoom=".urlencode($_REQUEST['startzoom']);
}
else {
	$mappingurl.="?startzoom=9";
}
$searchterms=array();
if ($_REQUEST['keywords']) {
	$terms=explode(" ",$_REQUEST['keywords']);
	foreach ($terms as $term) {array_push($searchterms,$term);}
	$mappingurl.="&keywords=".urlencode($_REQUEST['keywords']);
}
if ($_REQUEST['city']) {
	array_push($searchterms,$_REQUEST['city']);
	$mappingurl.="&city=".urlencode($_REQUEST['city']);
}
if ($_REQUEST['country']) {
	array_push($searchterms,$_REQUEST['country']);
	$mappingurl.="&country=".urlencode($_REQUEST['country']);
}
if ($_REQUEST['zip']) {
	array_push($searchterms,$_REQUEST['zip']);
	$mappingurl.="&zip=".urlencode($_REQUEST['zip']);
}
