<?php
$clat=40.8157;
$clong=-73.1187 ;
if ($_REQUEST['centerlong'] && $_REQUEST['centerlat']) {
	$clat=$_REQUEST['centerlat'];
	$clong=$_REQUEST['centerlong'] ;
}
else {
	try {
		$url="http://ipinfodb.com/ip_query.php?timezone=false&ip=".$_SERVER['REMOTE_ADDR'];
		$xmlcontent=file_get_contents($url);
		$geoxml=new SimpleXMLElement($xmlcontent);
		#print_r($geoxml);
		$clat=$geoxml->Latitude;
		$clong=$geoxml->Longitude;
	}
	catch (Exception $e) {
		echo 'Caught exception: ',  $e->getMessage(), "\n";
	}
}
